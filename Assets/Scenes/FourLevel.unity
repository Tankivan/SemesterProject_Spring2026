  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0438
    \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u044F 2025 \u0433\u043E\u0434\u0430,
    \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0435\u0439
    \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u0430.
    \n\u0412\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u0441\u0451 \u0435\u0449\u0451 \u0447\u0438\u0441\u043B\u044F\u0442\u0441\u044F
    \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u043F\u043E\u0438\u0441\u043A\u0435.\n\u0417\u0430\u0434\u0430\u043D\u0438\u0435:\u0412\u044B\u0432\u0435\u0434\u0438\u0442\u0435
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u0438 \u0430\u0432\u0442\u043E\u0440\u043E\u0432
    \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0431\u044B\u043B\u0438 \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u044B, \u043D\u043E
    \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u044B \n(\u043F\u043E\u043B\u0435
    \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D \u0438\u043C\u0435\u0435\u0442
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 FALSE)."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
