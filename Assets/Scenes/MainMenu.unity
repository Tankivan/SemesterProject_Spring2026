  m_text: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F:\n\u0422\u044B
    \u0431\u0443\u0434\u0435\u0448\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u044C
    \u0437\u0430\u0434\u0430\u043D\u0438\u044F, \u0434\u043B\u044F \u0440\u0435\u0448\u0435\u043D\u0438\u044F
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
