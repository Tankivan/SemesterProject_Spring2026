  m_text: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C, \u0432\u0430\u0448\u0435
    \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0434\u043E\u0440\u0430\u0431\u043E\u0442\u043A\u0438.
    \n\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0435
    \u0440\u0430\u0437!\n\n\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430:\n\u041D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0438\u0437 \u0442\u0430\u0431\u043B\u0438\u0446\u044B \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442\u044B
    \u043E\u0442\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u0442\u0440\u043E\u043A\u0438
    \u043F\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044E \u0437\u0430\u0434\u0430\u043D\u0438\u044F,
    \n\u0430 \u0437\u0430\u0442\u0435\u043C \u0443\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u0438\u0442\u044C
    \u0434\u0430\u043D\u043D\u044B\u0435."
