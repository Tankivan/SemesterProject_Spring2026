  m_text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043E
    \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432!\n\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u0430\u0432\u044B - \u0412\u0438\u043D\u0447\u0435\u043D\u0446\u043E
    \u041F\u0435\u0440\u0443\u0434\u0436\u0430 \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043B
    \u043A\u0440\u0430\u0436\u0443 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443.\n\u041E\u043D
    \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432 \u041B\u0443\u0432\u0440\u0435
    \u0438 \u0437\u043D\u0430\u043B, \u043A\u0430\u043A \u0441\u043D\u044F\u0442\u044C 
    \u043A\u0430\u0440\u0442\u0438\u043D\u0443 \u0441\u043E \u0441\u0442\u0435\u043D\u044B,
    \u043D\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u044F \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F."
