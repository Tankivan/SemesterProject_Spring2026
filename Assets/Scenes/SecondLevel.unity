  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u0438\u0437 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C
    \u043D\u0430\u043C \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u043E \u0442\u043E\u043C,
    \u0447\u0442\u043E \u043F\u043E\u0445\u0438\u0442\u0438\u0442\u0435\u043B\u044C
    \u043A\u0430\u0440\u0442\u0438\u043D\u044B \"\u041C\u043E\u043D\u0430 \u041B\u0438\u0437\u0430\"
    -\_ \u0412\u0438\u043D\u0447\u0435\u043D\u0446\u043E \u041F\u0435\u0440\u0443\u0434\u0436\u0430.
    \n\u041D\u043E \u043C\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u043C \u0431\u044B\u043B\u0438
    \u043B\u0438 \u0443 \u043D\u0435\u0433\u043E \u0441\u043E\u043E\u0431\u0449\u043D\u0438\u043A\u0438.
    \u041D\u0430\u0439\u0434\u0435\u043C \u043E\u0442\u0432\u0435\u0442 \u043D\u0430
    \u0434\u0430\u043D\u043D\u044B\u0439 \u0432\u043E\u043F\u0440\u043E\u0441.\n\u0417\u0430\u0434\u0430\u043D\u0438\u0435:
    \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0438\u043C\u0435\u043D\u0430, \u0444\u0430\u043C\u0438\u043B\u0438\u0438
    \u0438 \u0440\u043E\u043B\u0438 \u0432\u0441\u0435\u0445 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
    \u0432 \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0438 \n\u043F\u043E\u0434
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435\u043C \xAB\u041A\u0440\u0430\u0436\u0430
    \u041C\u043E\u043D\u044B \u041B\u0438\u0437\u044B 1911\xBB."
  m_isRightToLeft: 0
