      m_Calls: []
  m_text: "\u0412\u0435\u0440\u0441\u0438\u044F \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F,
    \u043D\u043E \u0444\u0430\u043A\u0442\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0442
    \u0438\u043D\u0430\u0447\u0435.\n\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \u043A \u0443\u043B\u0438\u043A\u0430\u043C \u0438 \u0432\u044B \u043D\u0430\u0439\u0434\u0435\u0442\u0435
    \u0432\u0435\u0440\u043D\u044B\u0439 \u043E\u0442\u0432\u0435\u0442, \u0430 \u043C\u044B
    \u043F\u043E\u043C\u043E\u0436\u0435\u043C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u043E\u0439!\n\n\u0421\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435
    \u0442\u0440\u0438 \u0442\u0430\u0431\u043B\u0438\u0446\u044B, \u0442\u0435\u043C
    \u0441\u0430\u043C\u044B\u043C \u0432\u044B \u043E\u0442\u0441\u0435\u0435\u0442\u0435
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u043E\u0435 \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435."
