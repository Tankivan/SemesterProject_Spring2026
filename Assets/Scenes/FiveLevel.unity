      m_Calls: []
  m_text: "\u041D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u0442\u0430\u043A!
    \u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E:\n1.
    \u0412\u044B \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0438\u043B\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B\n2. \u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438
    \u0430\u0432\u0442\u043E\u0440\u0430 \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u044D\u043A\u0441\u043F\u043E\u043D\u0430\u0442\u0430\n3. \u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438
    \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0434\u0430\u043D\u043D\u044B\u0445\n\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \u043A \u0431\u0430\u0437\u0435 \u0434\u0430\u043D\u043D\u044B\u0445 \u0438 \u0432\u044B
    \u043D\u0430\u0439\u0434\u0435\u0442\u0435 \u0432\u0435\u0440\u043D\u044B\u0439
    \u043E\u0442\u0432\u0435\u0442, \u044F \u0432 \u0432\u0430\u0441 \u0432\u0435\u0440\u044E!"
  m_isRightToLeft: 0
